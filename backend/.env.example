# ──────────────────────────────────────────────────────────────────────────────
# Netra AI Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# JWT Settings
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Email (OTP delivery) ──────────────────────────────────────────────────────
# Priority: Resend → SendGrid → SMTP → console (dev mode)

# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (Gmail App Password, Zoho, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password_here

# Sender identity shown in emails
FROM_EMAIL=noreply@netra.ai
FROM_NAME=Netra AI

# ── SMS (OTP delivery) ────────────────────────────────────────────────────────
# Priority: Twilio → Fast2SMS → console (dev mode)

# Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Fast2SMS – India only (https://www.fast2sms.com)
FAST2SMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
