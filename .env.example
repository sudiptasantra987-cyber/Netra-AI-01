# =============================================================================
# NETRA AI - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Environment (production / development)
ENVIRONMENT=production

# Server Network Binding (Render/Railway/Heroku auto-injects $PORT)
HOST=0.0.0.0
PORT=8000

# Security: JWT Secret Key (Generate a random 32+ char key: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production-use

# CORS: Comma-separated list of allowed origins (* for all)
ALLOWED_ORIGINS=*

# Optional: Persistent Storage Paths (used when mounting cloud volumes)
# DATABASE_FILE=/app/database/netra_store.json
# UPLOADS_DIR=/app/backend/uploads

# Optional: Decoupled Frontend API Base URL (leave empty for unified single-container mode)
# VITE_API_BASE_URL=https://api.yourdomain.com
